<?xml version="1.0" encoding="utf-8"?>
<!-- Pano geri / son uygulamalar / yarım ekran düğmelerine basar ve öndeki uygulamanın paket adını alır
     (alt şerit aracın kendi ana ekranında gizlensin diye). Pencere içeriğine yalnızca bir durumda bakar:
     sağ panelde küçük pencere olarak açılmış bir uygulama tam ekran açılırken o pencerenin çubuğundaki
     "büyüt" düğmesini bulup basmak için (system/FreeformFix.kt). Ses tuşlarını Ufuk'ta yakalar: aracın
     ses paneli yerine Pano'nun kendi göstergesi açılır (system/VolumeKeys.kt); diğer tuşlara dokunmaz. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/accessibility_description"
    android:notificationTimeout="100" />
