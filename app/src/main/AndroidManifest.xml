<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Harita karoları için internet, konum noktası için konum izni -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Pano Asistan: yalnızca dock'taki düğmeye basınca mikrofon açılır -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Direksiyon tuşuyla, Pano ekranda değilken açılan asistan oturumunda mikrofon susturulmasın -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Haritanın altındaki adada son kullanılan uygulamalar için (kullanıcı ayrıca izin verir). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Uygulama listesini görebilmek için (Android 11+) -->
    <!-- Sağ paneldeki uygulamanın üstüne yuvarlak köşeli çerçeve için (kullanıcı izin verir) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Pano'nun telefon kartı: rehber, son aramalar ve doğrudan arama. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Aramanın telefonun Bluetooth hattından çıkması için hatları okumak (aracın SIM'i seçilmesin). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Uygulama içi güncelleme: GitHub'dan indirilen yeni sürümü kurmak için (kullanıcı onaylar) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Hızlı ayarlar: Bluetooth ve Wi-Fi durumunu göstermek için (araç Android 10). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Sistem çubuklarını tüm uygulamalarda gizlemek için; yalnızca adb ile verilebilir (pm grant) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Aracın kendi ana ekranı: Pano'nun alt şeridi orada gizlenir (system/ForegroundApp.kt). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Telefon ve müzik için standart uygulama var mı diye bakılır; yoksa aracınkine düşülür. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <!-- Hızlı ayarlar: Android'in Bluetooth / Wi-Fi ayar ekranı var mı (yoksa düğme çizilmez). -->
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <!-- BYD araçta modelin kendi görseli bu eklentiden okunur. -->
        <package android:name="com.byd.carsettings.plugins" />
        <!-- Sesli asistan: önce BYD'ninki, yoksa Android'in standart sesli komut / asistan ekranı. -->
        <package android:name="com.byd.vrassistant" />
        <!-- Aracın radyo ekranı (medya merkezi) -->
        <package android:name="com.byd.mediacenter" />
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pano">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Ana ekran (launcher) olarak seçilebilmesi için -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Çalan müziği okumak için (kullanıcı bildirim erişimi vermeli) -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Alt şeritteki Geri / Son uygulamalar / Yarım ekran için (kullanıcı Erişilebilirlik'ten açar) -->
        <service
            android:name=".system.PanoAccessibility"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pano_accessibility" />
        </service>

        <!-- Pano Asistan: direksiyon tuşuyla arka planda açılan oturum (assistant/VoiceKey.kt) -->
        <service
            android:name=".assistant.AssistantForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Uygulama içi güncellemenin yükleyici sonucu -->
        <receiver
            android:name=".update.Updater$InstallResult"
            android:exported="false">
            <intent-filter>
                <action android:name="app.pano.launcher.UPDATE_INSTALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
